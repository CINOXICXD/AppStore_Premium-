        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
            gap: 25px;
        }

        .card {
            background: #1d1d1d;
            padding: 25px;
            border-radius: 15px;
            text-align: center;
            border: 1px solid #333;
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-7px);
            border-color: #00ff88;
        }

        .card .icon {
            font-size: 60px;
            margin-bottom: 15px;
        }

        .card h3 {
            margin-bottom: 10px;
        }

        .card p {
            color: #aaa;
            margin-bottom: 15px;
        }

